{
    "name": "workspace",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "build": "pnpm run typecheck && pnpm -r --if-present run build",
        "build:deploy": "pnpm --filter @workspace/startupvisual run build && pnpm --filter @workspace/api-server run build",
        "start:deploy": "pnpm --filter @workspace/api-server run start:production",
        "typecheck": "tsc --build && pnpm -r --filter \"./server\" --filter \"./client\" --if-present run typecheck"
    },
    "private": true,
    "devDependencies": {
        "prettier": "^3.8.3",
        "typescript": "~5.9.3"
    },
    "dependencies": {
        "@tailwindcss/oxide-win32-x64-msvc": "^4.3.0",
        "lightningcss-win32-x64-msvc": "^1.32.0"
    }
}
